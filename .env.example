# =============================================================================
# Ken Research Agentic Interlinking OS — local development configuration
#
# Copy to .env (gitignored) and adjust. Every variable uses the KEN_ prefix.
#
# These defaults implement the PREFERRED Mac development topology ("Mode A"):
#
#   PostgreSQL  container      localhost:5433  (docker compose up -d postgres)
#   Ollama      host daemon    127.0.0.1:11434 (your existing install)
#   FastAPI     native process 127.0.0.1:8000  (make dev-api)
#   Next.js     native process 127.0.0.1:3000  (make dev-web)
#
# Nothing here requires exposing Ollama on 0.0.0.0.
# NEVER commit real credentials. The values below are local-only placeholders.
# =============================================================================

# ---- service ----------------------------------------------------------------
KEN_SERVICE_NAME=ken-api
KEN_ENVIRONMENT=local
KEN_LOG_LEVEL=INFO
# console for humans, json for machines
KEN_LOG_FORMAT=console

# ---- database ---------------------------------------------------------------
# Driver: asyncpg (Apache-2.0) -- the only accepted scheme is postgresql+asyncpg://
# (docs/adr/ADR-0004.md). Port 5433 is the project container. Port 5432 is a separate, pre-existing
# PostgreSQL on this machine and must NOT be used. See docs/adr/ADR-0003.md.
KEN_DATABASE_URL=postgresql+asyncpg://ken:ken@localhost:5433/ken_interlink
# Fail fast if the database is unreachable (asyncpg's own default is 60 s).
KEN_DATABASE_CONNECT_TIMEOUT_S=5

# ---- model server -----------------------------------------------------------
# mock   = deterministic, no server needed (tests and CI always use this)
# ollama = the host daemon at KEN_OLLAMA_BASE_URL
KEN_MODEL_PROVIDER=ollama
KEN_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Models are chosen by ROLE. Business logic never names a model.
KEN_MODEL_FAST=qwen3:8b-q4_K_M
KEN_MODEL_REASONING=qwen3:8b-q4_K_M
# Local embedding model (Apache-2.0; `ollama pull nomic-embed-text`). Its
# dimension is read from the provider at runtime, never assumed.
KEN_MODEL_EMBEDDING=nomic-embed-text

# ---- cms --------------------------------------------------------------------
# mock (default, in memory) | simulated (local end-to-end CMS in its OWN database,
# created by `make cms-sim-seed`) | http (TRD s13 adapter; inert until enabled).
KEN_CMS_PROVIDER=mock
# KEN_CMS_SIM_DATABASE_URL=postgresql+asyncpg://ken:ken@localhost:5433/ken_cms_sim
# HttpCMSProvider. Placeholders only: never commit a real token. Every call is refused
# unless the base URL is loopback or KEN_CMS_ALLOW_REMOTE=true; writes also need
# KEN_CMS_WRITES_ENABLED=true. Connecting to the real Ken CMS is an ASK action.
# KEN_CMS_BASE_URL=
# KEN_CMS_TOKEN=
# KEN_CMS_WRITES_ENABLED=false
# KEN_CMS_ALLOW_REMOTE=false
# KEN_CMS_TIMEOUT_S=10

# ---- deployment (Phase 6) -----------------------------------------------------
# HTTP verification runs only when this is set (e.g. the URL `make cms-sim-serve` prints).
# KEN_DEPLOY_VERIFY_BASE_URL=
# KEN_DEPLOY_ALLOWED_HOSTS=
# KEN_DEPLOY_VERIFY_ATTEMPTS=3
# KEN_DEPLOY_VERIFY_RETRY_DELAY_S=2
# KEN_DEPLOY_RECONCILE_AFTER_S=300

# ---- analytics (Phase 7) ------------------------------------------------------
# Reading stored analytics needs nothing here. CSV imports need nothing here either:
# `make analytics-import ... FILE=rows.csv` reads a local file.
#
# GA4 / Search Console. Calling Google is EXTERNAL EGRESS and an ASK action: it stays
# refused before any request is made while this is false. Only the property id and the
# dates are ever sent — never a URL, a link id or page content.
# KEN_ANALYTICS_GOOGLE_ENABLED=false
# A file holding a short-lived READ-ONLY OAuth access token, mode 0600. Placeholder only:
# never commit a token. It is re-read per import and never logged or exposed by /meta.
# KEN_ANALYTICS_GOOGLE_TOKEN_FILE=
# KEN_GA4_PROPERTY_ID=
# The GA4 property's own time zone decides its day boundaries (Search Console uses
# America/Los_Angeles, first-party uses UTC).
# KEN_GA4_TIMEZONE=UTC
# 'sc-domain:example.com' or a URL-prefix property.
# KEN_GSC_SITE_URL=
# KEN_ANALYTICS_IMPORT_MAX_FILE_BYTES=50000000

# First-party collector (`make analytics-sim-serve`). It binds loopback on a free port and
# is never part of the API. Serving it from a real site is an ASK action, and a non-loopback
# bind OR a non-loopback allowed origin additionally requires KEN_COLLECTOR_ALLOW_REMOTE.
# KEN_COLLECTOR_HOST=127.0.0.1
# KEN_COLLECTOR_ALLOWED_ORIGINS=
# KEN_COLLECTOR_ALLOW_REMOTE=false

# ---- content inventory (Phase 1) --------------------------------------------
# There is NO default site. The crawler refuses to start until you set the ONE
# site you have approved for crawling. File imports (make ingest-file) do not
# need it. Never point this at a site you do not own or have permission to crawl.
# KEN_CRAWL_BASE_URL=https://www.your-approved-site.example/
# Extra in-scope hosts, comma-separated (subdomains are NOT implied):
# KEN_CRAWL_ALLOWED_HOSTS=www.your-approved-site.example
KEN_CRAWL_USER_AGENT="KenInterlinkBot/0.1 (self-hosted content inventory; read-only)"
# Politeness. robots.txt is always honoured and cannot be switched off.
KEN_CRAWL_DELAY_S=1.0
KEN_CRAWL_CONCURRENCY=2
KEN_CRAWL_MAX_PAGES=500
KEN_CRAWL_MAX_DEPTH=10
KEN_CRAWL_TIMEOUT_S=15
KEN_CRAWL_MAX_BYTES=5000000
KEN_CRAWL_MAX_REDIRECTS=5
# SSRF guard escape hatch: admits LOOPBACK fixtures only; refused unless KEN_ENVIRONMENT is local/ci.
# KEN_CRAWL_ALLOW_PRIVATE_NETWORKS=false
KEN_INGEST_MAX_FILE_BYTES=200000000

# ---- content intelligence (Phase 2) -----------------------------------------
# Analysis: `make analyze`. The taxonomy is versioned policy data.
# KEN_TAXONOMY_PATH=policies/taxonomy/taxonomy.v1.yaml
# Embedding recipe (prefixes are the default model's conventions). The document
# prefix and max chars form the recipe fingerprint: changing either re-embeds.
KEN_EMBEDDING_DOCUMENT_PREFIX="search_document: "
KEN_EMBEDDING_QUERY_PREFIX="search_query: "
KEN_EMBEDDING_MAX_CHARS=6000
KEN_EMBEDDING_BATCH_SIZE=16
# semantic_similar edges: top-k neighbours above a MODEL-SPECIFIC cosine threshold
# (0.78 calibrated for nomic-embed-text; use ~0.3 with the mock provider).
KEN_SIMILARITY_TOP_K=10
KEN_SIMILARITY_MIN_SCORE=0.78
# Max materialised taxonomy edges per (source page, relationship type).
KEN_RELATIONSHIP_MAX_PER_TYPE=25

# ---- recommendations and agents (Phases 3-4) --------------------------------
# Versioned policy data. `make recommend` produces plans; `make agents` reviews them.
# KEN_RECOMMENDATION_POLICY_PATH=policies/recommendation/recommendation.v1.yaml
# KEN_AGENTS_POLICY_PATH=policies/agents/agents.v1.yaml

# ---- readiness --------------------------------------------------------------
# false = absence degrades /ready (HTTP 200) instead of failing it (HTTP 503).
# ADR-0017 replaced pgvector with the vector store, so KEN_REQUIRE_PGVECTOR is gone.
# KEN_REQUIRE_QDRANT defaults true; with the default KEN_VECTOR_STORE=qdrant an
# unreachable Qdrant makes /ready 503 (only the in-memory test store always answers ok).
# KEN_REQUIRE_OLLAMA stays false: every model-backed feature has a deterministic
# path or degrades explicitly.
KEN_REQUIRE_QDRANT=true
KEN_REQUIRE_OLLAMA=false
KEN_READINESS_TIMEOUT_MS=2000

# ---- worker -----------------------------------------------------------------
KEN_WORKER_TICK_SECONDS=30

# ---- vector store (Phase 9, ADR-0017) ---------------------------------------
# PostgreSQL keeps the embedding VALUES and stays the source of truth; the vector
# store is a derived, rebuildable index. `qdrant` is the production semantic path and
# the local service (`make qdrant-up`, started by `make dev`). `memory` builds a throwaway
# exact index per run: it is what the test suite and CI use so they need no container,
# and a real installation must NOT run on it. `qdrant` is also the code default.
KEN_VECTOR_STORE=qdrant
KEN_QDRANT_URL=http://127.0.0.1:6333
KEN_QDRANT_COLLECTION=ken_pages
# KEN_QDRANT_API_KEY=            # optional; NEVER logged and never in /meta
KEN_QDRANT_TIMEOUT_S=10

# ---- autonomy (Phase 9, ADR-0018) -------------------------------------------
# There is no normal human approval step any more, so the safety lives here.
#
#   shadow      (DEFAULT) evaluate and record what WOULD have happened; publish nothing
#   guarded     auto-publish only low-risk, high-confidence decisions
#   autonomous  publish every policy-eligible decision
#
# Hard deterministic blocks apply in EVERY mode and are never waived. `autonomous`
# is refused unless KEN_AUTONOMY_AUTONOMOUS_ACKNOWLEDGED=true, and any publishing
# mode is refused against a write-enabled `http` CMS unless
# KEN_AUTONOMY_ALLOW_PRODUCTION=true. The process refuses to start rather than
# publish by surprise.
KEN_AUTONOMY_MODE=shadow
KEN_AUTONOMY_AUTONOMOUS_ACKNOWLEDGED=false
KEN_AUTONOMY_ALLOW_PRODUCTION=false
KEN_AUTONOMY_VERIFICATION_PROFILE=standard
KEN_AUTONOMY_STRICT_VERIFY_DELAY_S=30
KEN_AUTONOMY_STRICT_VERIFY_ATTEMPTS=2
# Retry budget and cool-down per (source, target): once spent, nothing republishes
# that pair, whatever the decision says (ADR-0018 section 4).
KEN_AUTONOMY_PUBLISH_MAX_ATTEMPTS=3
KEN_AUTONOMY_PUBLISH_COOLDOWN_S=3600

# RETIRED by ADR-0018 section 2, not reused: autonomy is expressed only by
# KEN_AUTONOMY_MODE. This flag MUST remain false — TRD.md section 20 requires
# AUTO_APPROVE to be disabled globally in v1, and setting true makes the process
# refuse to start.
KEN_AUTO_APPROVE_ENABLED=false

# ---- frontend ---------------------------------------------------------------
# apps/web reads KEN_API_BASE_URL from its PROCESS ENVIRONMENT, server-side only
# (never exposed to the browser). Next.js does NOT load this root .env file —
# it only loads .env files inside apps/web. The value below documents the
# default, which already matches Mode A; to override, export it in the shell
# before `make dev-web`. Kept here so the variable is discoverable.
KEN_API_BASE_URL=http://127.0.0.1:8000

# ---- database roles (ADR-0014 section 5; docs/DEVELOPMENT.md "Database roles") -------------
# Two DSNs. KEN_DATABASE_URL (above) is what the API, worker, jobs and CLIs use: point it at
# the least-privilege role `ken_app`. KEN_MIGRATION_DATABASE_URL is the OWNER role and is used
# ONLY by Alembic (`make migrate`) and the dev tools that create databases. When it is unset,
# migrations fall back to KEN_DATABASE_URL (the single-role dev setup).
# `make db-roles ARGS=--write-env` creates ken_app with a generated password and appends both
# lines to .env. The values below are PLACEHOLDERS; never commit a real password.
# KEN_DATABASE_URL=postgresql+asyncpg://ken_app:<generated-password>@localhost:5433/ken_interlink
# KEN_MIGRATION_DATABASE_URL=postgresql+asyncpg://ken:<owner-password>@localhost:5433/ken_interlink
# Optional: choose the ken_app password yourself instead of generating one.
# KEN_APP_DB_PASSWORD=
