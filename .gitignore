# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Environment / secrets
.env
.env.*
!.env.example
!.env.compose
*.pem
*.key

# Node
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.vitest/

# Reference repositories (research only, never vendored)
_research/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Local runtime artifacts
*.log
.colima/
/.tools/
/.codex/

# Graphify team outputs are committed; local caches and build state are not.
/graphify-out/cache/
/graphify-out/converted/
/graphify-out/.graphify_*

# Local compose override (see docker-compose.override.yml.example)
docker-compose.override.yml

# Eval runner reports (`make eval` writes one per run; the DATASETS are the committed
# artifact, the reports are not). A run bound to a proposal or a skill is recorded durably
# in `policy_evaluations`, which is the system of record for what a run measured.
evals/results/

# Credential files must never enter the repository (ADR-0022).
keys/
*-service-account*.json


# Playwright MCP (ADR-0024): named screenshots resolve against the working directory, so keep
# stray captures and browser logs out of git. Unnamed ones go to C:\Projects\browser-output.
/*.png
/*.jpeg
/*.jpg
/.playwright-mcp/

# Real-site exports and crawl output (public content, but large and regenerable)
/data/*
# ...except the v0.2 review state: the owner's approval decisions are not regenerable, and the
# review dashboard cannot start without its proposals file. 216 KB, no credentials.
!/data/v02-contextual-review/

# Playwright/Edge user-data directories written beside a run's audit artifacts. The JSON, Markdown
# and screenshot records in `outputs/` ARE the audit trail and are committed; a browser profile
# cache is 12MB of regenerable noise.
outputs/**/*-profile/
