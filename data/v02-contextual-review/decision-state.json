    "contextual:1": {
      "proposal_id": "contextual:1",
      "decision": "reject",
      "reason_code": "unnatural_anchor",
      "reason_note": "We are talking about Ai driven customer journey orchestration Market and the link we are creating is on journey orchestration, which is confusing and does not refer to a market, additionally record that we will avoid market overview section since this should conetrate on the mentioned market, creating an interlink to a related, regional, adjacent report will be too pushy.",
      "revision_note": "",
      "queued": false,
      "recorded_at": "2026-11-19T18:28:48.016Z"
    },
    "contextual:2": {
      "proposal_id": "contextual:2",
      "decision": "reject",
      "reason_code": "anchor_too_generic",
      "reason_note": "First thing, we are not going to add any interlink to any report's market overview section, since it will look to pushy and can dissolve the relevance of currently stated market. No market at end and context is quite light",
      "revision_note": "",
      "queued": false,
      "recorded_at": "2026-11-19T18:30:47.631Z"
    },
    "contextual:3": {
      "proposal_id": "contextual:3",
      "decision": "reject",
      "reason_code": "wrong_placement",
      "reason_note": "Market Overview must stay focused entirely on the current market and must never host an interlink to another market. Editing this section risks weakening the source report meaning. This suggestion also fails the reader-benefit test: it feels inserted to create a link instead of offering a clear, useful next piece of market information. Related Reports modules are also excluded because those reports are already listed there.",
      "revision_note": "",
      "queued": false,
      "recorded_at": "2026-11-19T18:44:58.988Z"
    },
