# =============================================================================
# Values for the OPTIONAL full-container mode ("Mode B"):
#   docker compose --profile full up -d
#
# Non-secret by construction: these credentials exist only inside the local
# compose network and the project container. Never reuse them anywhere else.
# =============================================================================
KEN_ENVIRONMENT=local
KEN_LOG_FORMAT=json
KEN_LOG_LEVEL=INFO

# Inside the compose network the database is reached by service name.
KEN_DATABASE_URL=postgresql+asyncpg://ken:ken@postgres:5432/ken_interlink

# A containerised API cannot reach the host Ollama (it is bound to 127.0.0.1),
# and Mode B must not require exposing it. So Mode B defaults to the
# deterministic mock provider, and the readiness probe reports the model
# server as optional. To use a real model in Mode B, enable the
# "ollama-container" profile and set KEN_MODEL_PROVIDER=ollama.
KEN_MODEL_PROVIDER=mock
KEN_OLLAMA_BASE_URL=http://ollama:11434
KEN_MODEL_FAST=qwen3:8b-q4_K_M
KEN_MODEL_REASONING=qwen3:8b-q4_K_M
KEN_MODEL_EMBEDDING=nomic-embed-text

KEN_CMS_PROVIDER=mock

# ADR-0017: no extension is created or required. Mode B talks to the compose
# `qdrant` service by name; the default `memory` store keeps tests container-free.
KEN_VECTOR_STORE=qdrant
KEN_QDRANT_URL=http://qdrant:6333
KEN_QDRANT_COLLECTION=ken_pages
KEN_REQUIRE_QDRANT=true
KEN_REQUIRE_OLLAMA=false

KEN_WORKER_TICK_SECONDS=30

# ADR-0018: shadow publishes nothing. Changing this needs the acknowledgement flags.
KEN_AUTONOMY_MODE=shadow
KEN_AUTO_APPROVE_ENABLED=false
KEN_API_BASE_URL=http://api:8000
